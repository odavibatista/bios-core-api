# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3000

# MongoDB em replica set (ver docker-compose.yml). directConnection evita a
# descoberta de membros, desnecessária em replica set de nó único.
DATABASE_URL="mongodb://localhost:27017/bios?directConnection=true"

# Redis (ver docker-compose.yml): filas BullMQ e, mais adiante, cache de consultas.
REDIS_URL="redis://localhost:6379"

# Filas.
# QUEUE_WAIT_TIMEOUT_MS: prazo padrão (1000 a 60000) da espera por um job quando a
# consulta do usuário depende dele. Estourado o prazo, o job segue na fila e quem
# chamou decide o que fazer — uma fonte não bloqueante vira UNKNOWN, sem falhar a
# consulta inteira. Pode ser sobrescrito por chamada.
QUEUE_WAIT_TIMEOUT_MS=10000

# QUEUE_SCHEDULES_SYNC_ON_BOOT: registra os jobs repetíveis (ex.: lote diário do
# IBAMA) a cada inicialização. O registro é idempotente, então reiniciar a API não
# duplica o disparo; desligue em instâncias que não devam agendar nada.
QUEUE_SCHEDULES_SYNC_ON_BOOT=true

# Cache de consultas. Janela de reserva, usada só quando a fonte não tem
# `cache_ttl_seconds` no banco: é lá que a janela de cada fonte é ajustada, sem
# novo deploy. Mesmo formato de duração da retenção abaixo; mínimo 1m.
CACHE_DEFAULT_TTL=7d

# Limite de requisições. Janela (1s a 1h) e número de requisições por janela.
# O limite geral é contado por IP; o da API pública, por chave de API, para que cada
# integrador tenha a própria cota. Os contadores ficam no Redis, então o limite vale
# para o consumidor e não para a instância. O health check fica isento.
THROTTLE_TTL=1m
THROTTLE_LIMIT=120
THROTTLE_PUBLIC_API_TTL=1m
THROTTLE_PUBLIC_API_LIMIT=60

# E-mails transacionais. Sem SMTP a aplicação não sobe: confirmação de cadastro e
# recuperação de senha dependem de envio. Em desenvolvimento, aponte para um
# servidor local de captura (ex.: Mailpit na porta 1025), nunca para um provedor
# real. A porta 465 fala TLS desde o primeiro byte; as demais usam STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=bios
SMTP_PASSWORD=troque-esta-senha
MAIL_FROM="BIOS <nao-responda@bios.local>"

# Origens permitidas no CORS: "*" ou lista separada por vírgulas
CORS_ORIGINS=*

# Criptografia de dados sensíveis (e-mail, endereço e hash da senha).
# Gere as duas chaves com: npm run keys:generate
#
# ENCRYPTION_KEYS: lista "versão:chave" separada por vírgula, com chaves de 32
# bytes em base64 ou hexadecimal. A maior versão é a ativa, usada nas novas
# cifragens; as anteriores são mantidas para decifrar documentos já gravados.
# Para rotacionar, acrescente a nova versão sem remover as antigas:
#   ENCRYPTION_KEYS=1:<chave antiga>,2:<chave nova>
ENCRYPTION_KEYS=1:TROQUE_POR_UMA_CHAVE_DE_32_BYTES_EM_BASE64

# BLIND_INDEX_KEY: chave única de 32 bytes do índice cego (busca de conta pelo
# e-mail sem decifrar a coleção). Não é versionada: trocá-la invalida todos os
# índices já gravados e exige regravá-los.
BLIND_INDEX_KEY=TROQUE_POR_UMA_CHAVE_DE_32_BYTES_EM_BASE64

# Custo do bcrypt no hash da senha (4 a 31). Cada incremento dobra o tempo de
# verificação: 12 fica na casta das centenas de milissegundos, o que torna a
# força bruta cara sem pesar no login. Aumentar não invalida as senhas já
# gravadas — elas seguem sendo verificadas com o custo com que foram criadas.
BCRYPT_COST=12

# Sessões: access token JWT de vida curta (1m a 60m) e refresh token de uso único,
# renovado a cada rotação (mínimo 1h). Mesmo formato de duração da retenção abaixo.
AUTH_ACCESS_TOKEN_LIFETIME=15m
AUTH_REFRESH_TOKEN_LIFETIME=7d

# Retenção de dados (índices TTL do MongoDB).
# Duração = inteiro + unidade obrigatória: m (minutos), h, d, w (semanas); mínimo 1m.
# Tokens, sessões e bloqueios contam a partir do vencimento; logs, a partir do registro.
# Os índices são sincronizados a cada inicialização da API; alterar um prazo aqui
# atualiza o índice existente, sem recriá-lo.
DATA_RETENTION_SYNC_ON_BOOT=true
DATA_RETENTION_USER_TOKENS=7d
DATA_RETENTION_USER_SESSIONS=30d
DATA_RETENTION_ACCESS_BLOCKS=90d
DATA_RETENTION_LOGIN_ATTEMPTS=90d
DATA_RETENTION_HONEYPOT_HITS=180d
DATA_RETENTION_EMAIL_DISPATCH_LOGS=180d
DATA_RETENTION_DATA_SOURCE_REQUEST_LOGS=90d
